<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Shabeena Shaikh | Hospitality HR Professional</title>

<meta name="description" content="Shabeena Shaikh — Dubai-based hospitality HR professional.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

<style>

/* =====================================================
   VARIABLES
===================================================== */

:root{
    --ink:#173536;
    --ink2:#244949;
    --gold:#b58a55;
    --gold2:#d4b07a;
    --cream:#f5f1e9;
    --cream2:#ebe4d7;
    --white:#ffffff;
    --muted:#70807e;
    --line:#ded7cb;
    --shadow:0 25px 70px rgba(23,53,54,.12);
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'DM Sans',Arial,sans-serif;
    color:var(--ink);
    background:#fff;
    line-height:1.7;
    overflow-x:hidden;
}

a{
    color:inherit;
    text-decoration:none;
}

button{
    font-family:inherit;
}

.container{
    width:min(1160px,88%);
    margin:auto;
}


/* =====================================================
   NAVIGATION
===================================================== */

.navbar{
    position:absolute;
    top:0;
    left:0;
    width:100%;
    z-index:50;
    padding:28px 6%;
}

.nav-inner{
    max-width:1160px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-family:'Playfair Display',serif;
    font-size:31px;
    font-weight:700;
}

.logo span{
    color:var(--gold);
}

.nav-links{
    display:flex;
    gap:27px;
    font-size:11px;
    font-weight:700;
    letter-spacing:.5px;
}

.nav-links a{
    transition:.3s;
}

.nav-links a:hover{
    color:var(--gold);
}


/* =====================================================
   HERO
===================================================== */

.hero{
    min-height:900px;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 73% 43%,#dfece9 0,#f0ece4 34%,#faf8f3 70%);
}

.hero-orb{
    position:absolute;
    border-radius:50%;
    border:1px solid rgba(181,138,85,.2);
    pointer-events:none;
}

.orb1{
    width:500px;
    height:500px;
    right:-180px;
    top:120px;
}

.orb2{
    width:300px;
    height:300px;
    left:-170px;
    bottom:-130px;
}

.orb3{
    width:170px;
    height:170px;
    right:30%;
    top:18%;
    border-style:dashed;
    animation:spin 30s linear infinite;
}

@keyframes spin{
    to{transform:rotate(360deg)}
}

.hero-content{
    min-height:900px;
    padding:150px 0 80px;
    display:grid;
    grid-template-columns:1.1fr .9fr;
    align-items:center;
    gap:80px;
    position:relative;
    z-index:2;
}

.eyebrow{
    font-size:10px;
    letter-spacing:3px;
    color:var(--gold);
    font-weight:700;
}

.hero h1{
    font-family:'Playfair Display',serif;
    font-size:clamp(56px,7vw,90px);
    line-height:1;
    letter-spacing:-3px;
    margin:22px 0 28px;
}

.hero h1 em{
    color:var(--gold);
    font-style:italic;
}

.hero-description{
    max-width:580px;
    color:var(--muted);
    font-size:18px;
}

.hero-actions{
    display:flex;
    align-items:center;
    gap:25px;
    margin-top:35px;
}

.primary{
    background:var(--ink);
    color:#fff;
    padding:15px 24px;
    font-size:11px;
    font-weight:700;
    letter-spacing:.8px;
    transition:.3s;
}

.primary:hover{
    background:var(--gold);
}

.linkedin{
    font-size:12px;
    font-weight:700;
    border-bottom:1px solid var(--gold);
}


/* =====================================================
   HERO PORTRAIT
===================================================== */

.hero-visual{
    position:relative;
    display:flex;
    justify-content:center;
}

.photo-frame{
    width:370px;
    height:510px;
    position:relative;
}

.photo-frame::before{
    content:"";
    position:absolute;
    inset:20px -20px -20px 20px;
    border:1px solid var(--gold);
}

.photo-frame img{
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center top;
    position:relative;
    z-index:3;
    box-shadow:var(--shadow);
}

.photo-label{
    position:absolute;
    z-index:5;
    left:-40px;
    bottom:28px;
    background:var(--ink);
    color:#fff;
    padding:15px 20px;
    font-size:10px;
    letter-spacing:1.5px;
    box-shadow:0 12px 30px rgba(23,53,54,.18);
}


/* =====================================================
   FLOATING GRAPHIC CARDS
===================================================== */

.float-card{
    position:absolute;
    z-index:8;
    background:#fff;
    box-shadow:0 18px 45px rgba(23,53,54,.13);
    padding:16px 19px;
    border:1px solid rgba(181,138,85,.25);
    animation:float 4s ease-in-out infinite;
}

.float-card strong{
    display:block;
    font-family:'Playfair Display',serif;
    font-size:25px;
}

.float-card small{
    font-size:9px;
    letter-spacing:1px;
    color:var(--muted);
}

.card-employees{
    left:-65px;
    top:80px;
}

.card-hr{
    right:-55px;
    top:220px;
    animation-delay:1s;
}

.card-uae{
    left:-35px;
    bottom:80px;
    animation-delay:2s;
}

@keyframes float{
    0%,100%{transform:translateY(0)}
    50%{transform:translateY(-10px)}
}


/* =====================================================
   HERO META
===================================================== */

.hero-meta{
    position:absolute;
    bottom:0;
    left:0;
    width:100%;
    border-top:1px solid rgba(23,53,54,.15);
    padding:20px 6%;
    display:flex;
    justify-content:space-between;
    font-size:10px;
    color:var(--muted);
    z-index:5;
}


/* =====================================================
   GENERAL SECTIONS
===================================================== */

section{
    padding:110px 0;
}

.section-number{
    color:var(--gold);
    font-size:10px;
    letter-spacing:3px;
    font-weight:700;
    margin-bottom:20px;
}

.section-title{
    font-family:'Playfair Display',serif;
    font-size:clamp(42px,5vw,65px);
    line-height:1.08;
    letter-spacing:-1.5px;
}

.section-title span{
    color:var(--gold);
}


/* =====================================================
   STORY
===================================================== */

.story{
    background:#fff;
}

.story-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:100px;
    margin-top:55px;
}

.story-lead{
    font-family:'Playfair Display',serif;
    font-size:34px;
    line-height:1.25;
}

.story-text p{
    color:var(--muted);
    margin-bottom:22px;
}

.quote{
    margin-top:35px;
    border-left:2px solid var(--gold);
    padding:18px 0 18px 25px;
    font-family:'Playfair Display',serif;
    font-size:25px;
}


/* =====================================================
   IMPACT
===================================================== */

.impact{
    background:var(--cream);
}

.impact-head{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:40px;
}

.impact-head p{
    max-width:360px;
    color:var(--muted);
}

.metrics{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    margin-top:60px;
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
}

.metric{
    padding:40px 25px;
    border-right:1px solid var(--line);
}

.metric:last-child{
    border-right:none;
}

.metric-number{
    font-family:'Playfair Display',serif;
    font-size:50px;
}

.metric-title{
    display:block;
    font-size:13px;
    font-weight:700;
}

.metric-text{
    display:block;
    font-size:11px;
    color:var(--muted);
}


/* =====================================================
   EXPERTISE
===================================================== */

.expertise-head{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:40px;
}

.expertise-head p{
    max-width:380px;
    color:var(--muted);
}

.expertise-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    margin-top:60px;
    border-top:1px solid var(--line);
    border-left:1px solid var(--line);
}

.expertise-card{
    min-height:245px;
    padding:34px;
    border-right:1px solid var(--line);
    border-bottom:1px solid var(--line);
    background:#fff;
    cursor:pointer;
    position:relative;
    transition:.35s;
}

.expertise-card:hover{
    background:var(--ink);
    color:#fff;
    transform:translateY(-6px);
    box-shadow:0 20px 45px rgba(23,53,54,.13);
    z-index:2;
}

.expertise-card-number{
    color:var(--gold);
    font-size:10px;
    font-weight:700;
    letter-spacing:1px;
}

.expertise-card h3{
    font-family:'Playfair Display',serif;
    font-size:25px;
    line-height:1.15;
    margin:30px 0 12px;
}

.expertise-card p{
    color:var(--muted);
    font-size:13px;
    line-height:1.65;
}

.expertise-card:hover p{
    color:#b7c7c5;
}

.click-hint{
    position:absolute;
    right:25px;
    bottom:22px;
    font-size:9px;
    color:var(--gold);
    letter-spacing:1px;
}


/* =====================================================
   POPUP
===================================================== */

.popup{
    position:fixed;
    inset:0;
    background:rgba(10,28,29,.72);
    backdrop-filter:blur(7px);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:25px;
    z-index:100;
    opacity:0;
    visibility:hidden;
    transition:.3s;
}

.popup.active{
    opacity:1;
    visibility:visible;
}

.popup-box{
    width:min(600px,100%);
    background:#fff;
    padding:50px;
    position:relative;
    transform:translateY(20px);
    transition:.35s;
}

.popup.active .popup-box{
    transform:translateY(0);
}

.popup-number{
    color:var(--gold);
    font-size:11px;
    letter-spacing:2px;
    font-weight:700;
}

.popup-box h2{
    font-family:'Playfair Display',serif;
    font-size:38px;
    line-height:1.15;
    margin:18px 0;
}

.popup-box p{
    color:var(--muted);
    font-size:14px;
}

.close-popup{
    position:absolute;
    top:20px;
    right:22px;
    border:0;
    background:none;
    font-size:28px;
    cursor:pointer;
    color:var(--ink);
}


/* =====================================================
   CAREER
===================================================== */

.career{
    background:var(--ink);
    color:#fff;
}

.career .section-number{
    color:var(--gold2);
}

.career-head{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:40px;
}

.career-head p{
    max-width:380px;
    color:#aebdbc;
}

.timeline{
    margin-top:70px;
    border-left:1px solid rgba(255,255,255,.22);
}

.timeline-item{
    position:relative;
    padding:0 0 50px 45px;
    cursor:pointer;
}

.timeline-item:last-child{
    padding-bottom:0;
}

.timeline-item::before{
    content:"";
    position:absolute;
    left:-6px;
    top:5px;
    width:11px;
    height:11px;
    background:var(--gold);
    border-radius:50%;
    box-shadow:0 0 0 6px var(--ink);
}

.timeline-year{
    color:var(--gold2);
    font-size:10px;
    letter-spacing:2px;
    font-weight:700;
}

.timeline-item h3{
    font-family:'Playfair Display',serif;
    font-size:27px;
    margin:7px 0 3px;
}

.timeline-item p{
    color:#aebdbc;
    font-size:13px;
}

.timeline-item:hover h3{
    color:var(--gold2);
}


/* =====================================================
   TOOLKIT
===================================================== */

.toolkit{
    background:#faf8f4;
}

.toolkit-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-top:55px;
}

.tool-card{
    background:#fff;
    border:1px solid var(--line);
    padding:35px;
    position:relative;
    overflow:hidden;
}

.tool-card::after{
    content:"";
    position:absolute;
    width:80px;
    height:80px;
    border-radius:50%;
    border:1px solid rgba(181,138,85,.16);
    right:-30px;
    bottom:-30px;
}

.tool-label{
    color:var(--gold);
    font-size:9px;
    letter-spacing:2px;
    font-weight:700;
}

.tool-card h3{
    font-family:'Playfair Display',serif;
    font-size:25px;
    margin:10px 0;
}

.tool-card p{
    color:var(--muted);
    font-size:13px;
}


/* =====================================================
   RECOGNITION
===================================================== */

.recognition{
    background:var(--cream);
}

.recognition-head{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:40px;
}

.recognition-head p{
    max-width:380px;
    color:var(--muted);
}

.recognition-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    margin-top:60px;
    gap:15px;
}

.recognition-card{
    background:#fff;
    padding:35px;
    min-height:250px;
    border:1px solid var(--line);
    transition:.35s;
}

.recognition-card:hover{
    transform:translateY(-7px);
    box-shadow:var(--shadow);
}

.recognition-card-number{
    color:var(--gold);
    font-size:10px;
    letter-spacing:2px;
    font-weight:700;
}

.recognition-card h3{
    font-family:'Playfair Display',serif;
    font-size:23px;
    line-height:1.2;
    margin:25px 0 10px;
}

.recognition-card p{
    color:var(--muted);
    font-size:13px;
}


/* =====================================================
   EDUCATION
===================================================== */

.education{
    background:#fff;
}

.education-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
    margin-top:55px;
}

.education-card{
    border-top:2px solid var(--ink);
    padding:25px 5px;
}

.education-label{
    color:var(--gold);
    font-size:9px;
    letter-spacing:2px;
    font-weight:700;
}

.education-card h3{
    font-family:'Playfair Display',serif;
    font-size:22px;
    line-height:1.25;
    margin:14px 0 8px;
}

.education-card p{
    color:var(--muted);
    font-size:13px;
}


/* =====================================================
   CONTACT
===================================================== */

.contact{
    background:var(--gold);
    color:#fff;
    padding:95px 0;
}

.contact-inner{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:50px;
}

.contact .eyebrow{
    color:#fff;
}

.contact h2{
    font-family:'Playfair Display',serif;
    font-size:clamp(40px,5vw,62px);
    line-height:1.08;
    max-width:780px;
    margin-top:20px;
}

.contact-location{
    margin-top:20px;
    font-size:13px;
}

.contact-button{
    background:#fff;
    color:var(--ink);
    padding:17px 25px;
    font-size:11px;
    font-weight:700;
    white-space:nowrap;
    transition:.3s;
}

.contact-button:hover{
    background:var(--ink);
    color:#fff;
}


/* =====================================================
   FOOTER
===================================================== */

footer{
    background:#102c2d;
    color:#aebdbc;
    padding:25px 6%;
}

.footer-inner{
    max-width:1160px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    font-size:9px;
    letter-spacing:1.5px;
}

.footer-name{
    color:#fff;
    font-weight:700;
}


/* =====================================================
   SCROLL REVEAL
===================================================== */

.reveal{
    opacity:0;
    transform:translateY(25px);
    transition:opacity .8s ease,transform .8s ease;
}

.reveal.visible{
    opacity:1;
    transform:translateY(0);
}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:900px){

    .nav-links{
        display:none;
    }

    .hero-content{
        grid-template-columns:1fr;
        text-align:center;
        padding-top:120px;
    }

    .hero-copy{
        order:2;
    }

    .hero-visual{
        order:1;
    }

    .hero-description{
        margin:auto;
    }

    .hero-actions{
        justify-content:center;
    }

    .photo-frame{
        width:290px;
        height:410px;
    }

    .float-card{
        transform:scale(.85);
    }

    .card-employees{
        left:-20px;
    }

    .card-hr{
        right:-20px;
    }

    .card-uae{
        left:0;
    }

    .hero-meta{
        position:relative;
        flex-direction:column;
        gap:6px;
        align-items:center;
        text-align:center;
        margin-top:30px;
    }

    .story-grid{
        grid-template-columns:1fr;
        gap:45px;
    }

    .impact-head,
    .expertise-head,
    .career-head,
    .recognition-head,
    .contact-inner{
        display:block;
    }

    .impact-head p,
    .expertise-head p,
    .career-head p,
    .recognition-head p{
        margin-top:25px;
    }

    .metrics{
        grid-template-columns:1fr 1fr;
    }

    .metric:nth-child(2){
        border-right:none;
    }

    .expertise-grid{
        grid-template-columns:1fr 1fr;
    }

    .recognition-grid{
        grid-template-columns:1fr 1fr;
    }

    .education-grid{
        grid-template-columns:1fr;
    }

    .contact-button{
        display:inline-block;
        margin-top:35px;
    }
}


@media(max-width:600px){

    section{
        padding:75px 0;
    }

    .hero h1{
        font-size:52px;
        letter-spacing:-2px;
    }

    .hero-description{
        font-size:16px;
    }

    .photo-frame{
        width:250px;
        height:355px;
    }

    .photo-label{
        left:-10px;
    }

    .float-card{
        padding:11px 13px;
    }

    .float-card strong{
        font-size:19px;
    }

    .card-employees{
        left:-18px;
        top:60px;
    }

    .card-hr{
        right:-18px;
        top:180px;
    }

    .card-uae{
        left:-5px;
        bottom:45px;
    }

    .metrics{
        grid-template-columns:1fr;
    }

    .metric{
        border-right:none!important;
        border-bottom:1px solid var(--line);
    }

    .metric:last-child{
        border-bottom:none;
    }

    .expertise-grid{
        grid-template-columns:1fr;
    }

    .toolkit-grid{
        grid-template-columns:1fr;
    }

    .recognition-grid{
        grid-template-columns:1fr;
    }

    .popup-box{
        padding:35px 25px;
    }

    .popup-box h2{
        font-size:32px;
    }

    .contact h2{
        font-size:42px;
    }

    .footer-inner{
        flex-direction:column;
        gap:8px;
    }
}

</style>
</head>


